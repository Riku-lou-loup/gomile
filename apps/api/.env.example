# Local development only. Copy to .env and supply your own configuration.
# Never commit credentials, including expired or disabled keys.
DATABASE_URL="postgresql://gomile:gomile@localhost:5432/gomile?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
APP_URL="http://localhost:3001"
API_BASE_URL="http://localhost:4000"

# Generate two different random values locally.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# OpenRouteService
ORS_API_KEY=
ORS_BASE_URL="https://api.openrouteservice.org"

# AWS S3: your own region, bucket and IAM credentials
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Resend
RESEND_API_KEY=

# Stripe: use test-mode credentials for development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional legacy GitLab deployment webhook
GITLAB_WEBHOOK_SECRET=
